{
  "name": "cueline-desktop",
  "productName": "Cueline",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop shell for Cueline: a genuinely transparent, always-on-top prompter that screen sharing cannot see.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "smoke": "electron smoke-test.js",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.cueline.desktop",
    "productName": "Cueline",
    "files": ["main.js", "preload.js", "trayTemplate.png", "trayTemplate@2x.png", "../index.html", "../app.css", "../app.js", "../icons.js", "../script-parse.js"],
    "mac": { "category": "public.app-category.productivity", "target": [{ "target": "dmg", "arch": ["arm64", "x64"] }] }
  }
}
